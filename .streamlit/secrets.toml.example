# Copia este archivo a `.streamlit/secrets.toml` (ese sí está en .gitignore,
# nunca lo subas al repo) si quieres que el tablero se conecte a Odoo sin
# pedir credenciales cada vez que alguien lo abre — típicamente para un
# despliegue compartido (Streamlit Community Cloud, servidor propio, etc.).
#
# Si lo dejas sin configurar, el tablero simplemente mostrará el formulario
# de conexión en la barra lateral (credenciales solo en memoria de sesión).

[odoo]
url = "https://tuempresa.odoo.com"
db = "nombre_base_de_datos"
username = "usuario@firefly-e.com"
# Recomendado: usa una API key (Ajustes → tu usuario → Preferencias →
# Seguridad de la cuenta → Nueva clave API) en vez de la contraseña real,
# para poder revocarla sin cambiar la contraseña de inicio de sesión.
api_key = "tu-api-key-o-contraseña"
